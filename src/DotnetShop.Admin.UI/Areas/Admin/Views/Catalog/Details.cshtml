@using DotnetShop.Admin.UI.Areas.Admin.Models;
@model ProductModel

<h2>@Model.ProductName</h2>

<div>
    Id: @Model.ProductId
</div>
<div>
    Name: @Model.ProductName
</div>
<div>
    Short Description: @Model.ShortDescription
</div>
<div>
    Long Description:
    <p>@Model.LongDescription</p>
</div>
<div>
    Price: @Model.Price
</div>
<div>
    <div>Image Thumbnail</div>
    <img alt="@Model.ProductName" src="@Model.ImageThumbnailUrl" height="50" />
</div>
<div>
    <div>Images</div>
    @foreach (var image in Model.ImageUrls)
    {
        <img alt="@Model.ProductName" src="@image" height="500" />
    }
    @* TODO *@
    <div id="image-gallery"></div>
</div>
<div>
    Category Id: @Model.CategoryId
</div>

<a asp-area="Admin" asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary mt-3">All Products</a>
