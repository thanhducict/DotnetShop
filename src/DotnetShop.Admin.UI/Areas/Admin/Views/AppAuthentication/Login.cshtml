@model LoginDto

<div class="row pt-2">
    <h1>Log in</h1>
    <div class="col-lg-6 col-md-12">
        <h3>Use a local account to log in.</h3>
        <form method="post">
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>
            <div class="mb-3">
                <div class="col-2">
                    <label class="form-label" asp-for="@Model.UserName"></label>
                </div>
                <div class="col-5">
                    <input class="form-control" type="text" asp-for="@Model.UserName" value="admin" />
                </div>
                <span class="text-danger" asp-validation-for="@Model.UserName"></span>
            </div>
            <div class="mb-3">
                <div class="col-2">
                    <label class="form-label" asp-for="@Model.Password"></label>
                </div>
                <div class="col-5">
                    <input class="form-control" type="password" value="Cvbnm123@@" asp-for="@Model.Password" />
                </div>
                <span class="text-danger" asp-validation-for="@Model.Password"></span>
            </div>
            <div class="mb-3">
                <div class="col-5">
                    <input type="checkbox" asp-for="@Model.RememberMe" />
                    <label class="form-label" asp-for="@Model.RememberMe"></label>
                </div>
            </div>
            <div class="mb-3">
                <div class="col-2">
                </div>
                <div class="col-5">
                    <input type="submit" class="btn btn-primary" value="Login" />
                </div>
            </div>
        </form>
    </div>
    <div class="col-lg-6 col-md-12">
        <h3>Use another service to log in.</h3>
    </div>
</div>
