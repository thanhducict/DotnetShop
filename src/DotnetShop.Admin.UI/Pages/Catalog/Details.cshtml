@page
@model DotnetShop.Admin.UI.Pages.Catalog.DetailsModel
@{
}

<h2>@Model.Product.ProductName</h2>

<div>
    Id: @Model.Product.ProductId
</div>
<div>
    Name: @Model.Product.ProductName
</div>
<div>
    Short Description: @Model.Product.ShortDescription
</div>
<div>
    Long Description:
    <p>@Model.Product.LongDescription</p>
</div>
<div>
    Price: @Model.Product.Price
</div>
<div>
    <div>Image Thumbnail</div>
    <img alt="@Model.Product.ProductName" src="@Model.Product.ImageThumbnailUrl" height="50" />
</div>
<div>
    <div>Images</div>
    @foreach (var image in Model.Product.ImageUrls)
    {
        <img alt="@Model.Product.ProductName" src="@image" height="500" />
    }
    @* TODO *@
    <div id="image-gallery"></div>
</div>
<div>
    Category Id: @Model.Product.CategoryId
</div>

<a asp-area="Admin" asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary mt-3">All Products</a>
