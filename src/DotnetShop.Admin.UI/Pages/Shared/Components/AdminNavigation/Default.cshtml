@using DotnetShop.Admin.Core.MenuProvider
@model IEnumerable<AdminMenuItem>

<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container">
        <a class="navbar-brand" href="/">
            <span>Administration</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav flex-grow-1">
                @foreach (var item in Model)
                {
                    <a class="nav-link" asp-page="@item.AspPage" asp-page-handler="@item.AspPageHandler">@item.MenuItemText</a>
                }
            </div>
            <ul class="navbar-nav">
                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-page="/AppAuthentication/Login" asp-page-handler="Logout" asp-route-returnUrl="@Url.RouteUrl('/')" method="post" id="logoutForm">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a asp-area="Admin" asp-controller="Account" asp-action="Index"
                                    class="btn btn-link navbar-btn navbar-link">Hello @User.Identity.Name</a>
                            </li>
                            <li class="nav-item">
                                <button type="submit" class="btn btn-link navbar-btn navbar-link">Logout</button>
                            </li>
                        </ul>
                    </form>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/AppAuthentication/Register">Register</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-page="/AppAuthentication/Login">Login</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
