@model PagingInfoModel

@{
    var totalPages = Model.TotalPages;
}

<nav aria-label="Admin Pagination">
    <ul class="pagination">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" aria-label="Previous" asp-page="/Catalog/List"
               asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-pageSize="@Constants.PageSize">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        @for (var i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link" asp-page="/Catalog/List"
                   asp-route-pageNumber="@i" asp-route-pageSize="@Constants.PageSize">@i</a>
            </li>
        }
        <li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
            <a class="page-link" aria-label="Next" asp-page="/Catalog/List"
               asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-pageSize="@Constants.PageSize">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
    </ul>
</nav>
