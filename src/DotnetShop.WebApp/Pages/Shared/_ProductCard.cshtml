@model ProductModel

<div class="col-sm-6 col-md-4 col-lg-3">
    <div class="card mt-3 mb-3">
        <img src="@Model.ImageThumbnailUrl" class="card-img-top">
        <div class="card-body">
            <h5 class="card-title">@Model.Price.ToString("c")</h5>
            <h3>
                <a asp-page="/Catalog/Details" asp-route-id="@Model.ProductId" style="font-size: 20px;">
                    @Model.ProductName
                </a>
            </h3>
            <p class="card-text">@Model.ShortDescription</p>
            <form method="post" asp-page="/Cart" asp-page-handler="AddToCart">
                <div class="row">
                    <div class="col-8">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <button type="submit" class="btn btn-primary">Add to cart</button>
                    </div>
                    <div class="col-4"><input type="text" class="form-control" name="quantity" value="1"></div>
                </div>
            </form>
        </div>
    </div>
</div>
