<!DOCTYPE html>
<html lang="en">
<head>
    <title>Dotnet Shop</title>
    <link rel="stylesheet" href="~/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container">
            <a class="navbar-brand" href="#">
                <span style="color: #51a9ab; font-weight: 700;">.NET</span>
                <span style="color: black; font-weight: 350;"> Shop</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                <div class="navbar-nav">
                        @* <a class="nav-link" asp-controller="@item.AspController" asp-action="@item.AspAction">@item.MenuItemText</a> *@
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>
    <script src="~/bootstrap.min.js"></script>
</body>
</html>
