@page
@model CartModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Your shopping cart</h2>
@if (Model.CartViewModel.Items.Count == 0)
{
    <h4>Your cart is empty.</h4>
}
else
{
    <h5>Here are the items in your shopping cart.</h5>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Products</th>
                <th class="text-right">Price</th>
                <th>Amount</th>
                <th class="text-right">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.CartViewModel.Items)
            {
                <tr>
                    <td class="text-left">@line.ProductName</td>
                    <td class="text-right">@line.Price.ToString("c")</td>
                    <td class="text-center">@line.Quantity</td>
                    <td class="text-right">@((line.Price * line.Quantity).ToString("c"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right">Total:</td>
                <td class="text-right">
                    @Model.CartViewModel.TotalPrice.ToString("c")
                </td>
            </tr>
        </tfoot>
    </table>

    <div class="row">
        <div class="col-6">
            <div class="text-center">
                <form asp-page-handler="RemoveFromCart" method="post">
                    <button class="btn btn-danger" type="submit">Remove</button>
                </form>
            </div>
        </div>
        <div class="col-6">
            <div class="text-center">
                <form asp-page-handler="Checkout" method="post">
                    <button class="btn btn-primary" type="submit">Check out now!</button>
                </form>
            </div>
        </div>
    </div>
}
