<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>DotnetShop.Admin.Ordering</id>
        <version>$AdminOrderingVersion$</version>
        <description>Admin UI of Ordering for Dotnet Shop.</description>
        <authors>Thanh Duc Nguyen</authors>
        <contentFiles>
            <files include="any\any\modules\DotnetShop.Admin.Ordering\dotnetshop.admin.ordering.js" buildAction="None" copyToOutput="true" />
            <files include="any\any\modules\DotnetShop.Admin.Ordering\dotnetshop.admin.ordering.css" buildAction="None" copyToOutput="true" />
        </contentFiles>
        <dependencies>
            <group targetFramework="$TargetFramework$">
                <dependency id="DotnetShop.Admin.Core" version="$AdminCoreVersion$" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="src\DotnetShop.Admin.Ordering\ClientApp\dist\dotnetshop.admin.ordering.js" target="contentFiles\any\any\modules\DotnetShop.Admin.Ordering" />
        <file src="src\DotnetShop.Admin.Ordering\ClientApp\dist\dotnetshop.admin.ordering.css" target="contentFiles\any\any\modules\DotnetShop.Admin.Ordering" />
        <file src="src\DotnetShop.Admin.Ordering\bin\$Configuration$\$TargetFramework$\DotnetShop.Admin.Ordering.dll" target="lib\$TargetFramework$" />
        <file src="src\DotnetShop.Admin.Ordering\bin\$Configuration$\$TargetFramework$\DotnetShop.Admin.Ordering.pdb" target="lib\$TargetFramework$" />
        <file src="src\DotnetShop.Admin.Ordering\CopyResourceFiles.targets" target="build\$TargetFramework$\DotnetShop.Admin.Ordering.targets" />
    </files>
</package>
