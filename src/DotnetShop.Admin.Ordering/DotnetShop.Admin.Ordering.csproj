<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\build\nuspec.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuspecProperties>Configuration=$(Configuration);AdminOrderingVersion=$(AdminOrderingVersion);AdminCoreVersion=$(AdminCoreVersion)</NuspecProperties>
    <NuspecFile>DotnetShop.Admin.Ordering.nuspec</NuspecFile>
    <OutputType>Library</OutputType>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetShop.Admin.Core\DotnetShop.Admin.Core.csproj" />
  </ItemGroup>

</Project>
