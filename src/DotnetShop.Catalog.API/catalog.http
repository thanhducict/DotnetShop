@hostname=localhost

# Local
# @port=5050

# Docker
@port=6060

@host={{hostname}}:{{port}}

GET https://{{host}}/health
###

GET https://{{host}}/products
###

GET https://{{host}}/products?pageNumber=2&pageSize=10
###

POST https://{{host}}/products
Content-Type: application/json

{
    "name": "T-Shirt 3",
    "categories": ["shirt", "men"],
    "shortDescription": "This is a shirt for men.",
    "longDescription": "This is a shirt for men. This shirt is in very good quality.",
    "imageUrl" : "image URL",
    "imageThumbnailUrl" : "image Thumbnail URL",
    "price": 10
}
###

GET https://{{host}}/products/0192e886-4d6d-41d8-9d3c-19e07791e8c2
###

GET https://{{host}}/products/category/shirt
###

PUT https://{{host}}/products
Content-Type: application/json

{
    "id": "0192e886-4d6d-41d8-9d3c-19e07791e8c2",
    "name": "Shoes",
    "categories": ["shoes", "men"],
    "shortDescription": "This is a pair of shoes for men.",
    "longDescription": "This is a pair of shoes for men. This shirt is in very good quality.",
    "imageFile" : "image URL",
    "imageThumbnailUrl" : "image Thumbnail URL",
    "price": 5
}
###

DELETE https://{{host}}/products/
Content-Type: application/json

{
    "id": "0192dda5-2f93-40e8-9ad8-98c63232777f"
}
