@hostname=localhost
@port=6060

@host={{hostname}}:{{port}}

GET https://{{host}}/health
###

### Category ###
GET https://{{host}}/categories
###

POST https://{{host}}/categories
Content-Type: application/json
{
    "categoryName": "Notebook"
}

### Product ###
GET https://{{host}}/products
###

GET https://{{host}}/products?pageNumber=2&pageSize=10
###

POST https://{{host}}/products
Content-Type: application/json
{
    "productGuid": "659e3447-382c-49ed-a740-be12df8615ed",
    "productName": "T-Shirt 3",
    "shortDescription": "This is a shirt for men.",
    "longDescription": "This is a shirt for men. This shirt is in very good quality.",
    "imageUrls" : [
        "URL 1",
        "URL 2"
    ],
    "imageThumbnailUrl" : "image thumbnail URL",
    "price": 10,
    "categoryId": 1
}
###

GET https://{{host}}/products/13
###

GET https://{{host}}/products/category/cup
###

PUT https://{{host}}/products
Content-Type: application/json
{
    "productId": 13,
    "productGuid": "659e3447-382c-49ed-a740-be12df8615ed",
    "productName": "UPDATED T-Shirt 3",
    "shortDescription": "UPDATED This is a shirt for men.",
    "longDescription": "UPDATED This is a shirt for men. This shirt is in very good quality.",
    "imageUrls" : [
        "UPDATED URL 1",
        "UPDATED URL 2"
    ],
    "imageThumbnailUrl" : "UPDATED image thumbnail URL",
    "price": 20,
    "categoryId": 1
}
###

DELETE https://{{host}}/products/
Content-Type: application/json

{
    "productId": 13
}
